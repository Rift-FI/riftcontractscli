{
  "name": "usdc-approve-transfer",
  "chain": "base",
  "vars": {
    "usdc": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
    "spender": "0x3400d7aD28AdBbc3918f190C2034d1ED912BeC63",
    "recipient": "0x3400d7aD28AdBbc3918f190C2034d1ED912BeC63",
    "allowance": "100@6",
    "amount": "0.01@6"
  },
  "steps": [
    {
      "id": "approve",
      "label": "approve 100 USDC for the payout vault",
      "call": "approve(address spender, uint256 value) returns (bool)",
      "to": "$usdc",
      "args": ["$spender", "$allowance"],
      "check": {
        "to": "$usdc",
        "fn": "allowance(address,address) view returns (uint256)",
        "args": ["$account", "$spender"],
        "gte": "$allowance"
      }
    },
    {
      "id": "transfer",
      "label": "send 0.01 USDC",
      "call": "transfer(address to, uint256 amount) returns (bool)",
      "to": "$usdc",
      "args": ["$recipient", "$amount"],
      "unverifiable": true
    }
  ]
}
